<!DOCTYPE html> <html lang="bn"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Garments Barcode Scanner</title> <script src="https://unpkg.com/@zxing/browser@0.1.5/umd/index.min.js"></script> <style> body{font-family:Arial,sans-serif;background:#f3f5f8;margin:0;padding:16px;color:#172033} main{max-width:650px;margin:auto} h2{margin-top:5px} button,input{padding:12px;margin:5px 2px;border-radius:8px;border:1px solid #ccd2dc;font-size:16px} button{background:#155eef;color:white;border:0} button:disabled{opacity:.45} video{width:100%;background:#111;border-radius:12px;max-height:380px} .panel{background:white;padding:14px;border-radius:12px;margin:12px 0} #status{font-size:14px;color:#475467;white-space:pre-wrap} table{width:100%;border-collapse:collapse;background:white} td,th{padding:9px;border-bottom:1px solid #ddd;text-align:left} </style> </head> <body> <main> <h2>Garments Barcode Scanner</h2>  <div class="panel">   <input id="batch" placeholder="Batch name" value="Batch 1">   <br>   <button id="start">Start Camera</button>   <button id="stop" disabled>Stop</button>   <button id="flash" disabled>Flash ON</button>   <video id="video" autoplay muted playsinline></video>   <p id="status">Camera এখনো চালু হয়নি। Start Camera চাপো।</p> </div>  <div class="panel">   <h3>Batch Summary</h3>   <p>Scanned: <b id="count">0</b></p>   <p>Total Weight: <b id="total">0.000 KG</b></p>   <button id="export">Export CSV</button>   <button id="clear">Clear Batch</button> </div>  <div class="panel">   <h3>Scanned Items</h3>   <table>     <thead><tr><th>Barcode</th><th>Weight KG</th></tr></thead>     <tbody id="items"></tbody>   </table> </div> </main>  <script> const video = document.getElementById("video"); const statusBox = document.getElementById("status"); const startBtn = document.getElementById("start"); const stopBtn = document.getElementById("stop"); const flashBtn = document.getElementById("flash");  let reader = null; let scannerControls = null; let currentTrack = null; let flashOn = false; let items = JSON.parse(localStorage.getItem("garmentItems") || "[]"); let lastCode = ""; let lastScanTime = 0;  function save(){   localStorage.setItem("garmentItems", JSON.stringify(items));   render(); }  function render(){   document.getElementById("count").textContent = items.length;   const total = items.reduce((sum,x)=>sum + (Number(x.kg)||0),0);   document.getElementById("total").textContent = total.toFixed(3)+" KG";   document.getElementById("items").innerHTML = "";   items.forEach(x=>{     const tr = document.createElement("tr");     const td1 = document.createElement("td");     const td2 = document.createElement("td");     td1.textContent = x.code;     td2.textContent = Number(x.kg).toFixed(3);     tr.append(td1,td2);     document.getElementById("items").appendChild(tr);   }); }  async function startCamera(){   try{     if(!window.isSecureContext){       throw new Error("এই পেজ HTTPS website থেকে খুলতে হবে।");     }     if(!navigator.mediaDevices?.getUserMedia){       throw new Error("এই browser camera access support করছে না। Chrome update করো।");     }     if(!window.ZXingBrowser){       throw new Error("Barcode library load হয়নি। Internet connection check করো।");     }      startBtn.disabled = true;     statusBox.textContent = "Camera permission চাওয়া হচ্ছে...";      reader = new ZXingBrowser.BrowserMultiFormatReader();      scannerControls = await reader.decodeFromConstraints(       {         audio:false,         video:{           facingMode:{ideal:"environment"},           width:{ideal:1280},           height:{ideal:720}         }       },       video,       (result, error)=>{         if(result){           const code = result.getText();           const now = Date.now();            // একই barcode বারবার যোগ হওয়া আটকায়           if(code === lastCode && now-lastScanTime < 2500) return;           lastCode = code;           lastScanTime = now;            if(items.some(x=>x.code===code)){             statusBox.textContent = "Duplicate barcode: "+code;             return;           }            const answer = prompt("Barcode: "+code+"\nWeight KG লিখো:");           if(answer === null || answer.trim()===""){             statusBox.textContent = "Weight দেওয়া হয়নি। Barcode যোগ হয়নি: "+code;             return;           }            const kg = Number(answer);           if(!Number.isFinite(kg) || kg < 0){             statusBox.textContent = "ভুল weight। আবার scan করো।";             return;           }            items.push({             batch:document.getElementById("batch").value.trim() || "Batch 1",             code,             kg,             time:new Date().toISOString()           });           save();           statusBox.textContent = "Scanned: "+code+" | "+kg+" KG";         }       }     );      currentTrack = video.srcObject?.getVideoTracks?.()[0] || null;     stopBtn.disabled = false;     flashBtn.disabled = !hasTorch();     flashOn = false;     flashBtn.textContent = "Flash ON";     statusBox.textContent = "Camera চালু হয়েছে। Barcode দেখাও।";    }catch(err){     startBtn.disabled = false;     statusBox.textContent = "Camera error: "+err.name+"\n"+err.message+       "\n\nChrome site settings-এ Camera permission Allow আছে কি না দেখো।";     console.error(err);   } }  function hasTorch(){   if(!currentTrack || !currentTrack.getCapabilities) return false;   try{     return currentTrack.getCapabilities().torch === true;   }catch(e){ return false; } }  async function toggleFlash(){   if(!currentTrack) return;   try{     const next = !flashOn;     await currentTrack.applyConstraints({       advanced:[{torch:next}]     });     flashOn = next;     flashBtn.textContent = flashOn ? "Flash OFF" : "Flash ON";     statusBox.textContent = flashOn ? "Flash চালু" : "Flash বন্ধ";   }catch(err){     statusBox.textContent = "এই camera/browser-এ Flash control support নেই।";   } }  function stopCamera(){   try{     if(scannerControls) scannerControls.stop();     if(video.srcObject) video.srcObject.getTracks().forEach(t=>t.stop());   }catch(e){}   scannerControls = null;   currentTrack = null;   flashOn = false;   video.srcObject = null;   startBtn.disabled = false;   stopBtn.disabled = true;   flashBtn.disabled = true;   flashBtn.textContent = "Flash ON";   statusBox.textContent = "Camera বন্ধ।"; }  startBtn.addEventListener("click",startCamera); stopBtn.addEventListener("click",stopCamera); flashBtn.addEventListener("click",toggleFlash);  document.getElementById("clear").onclick=()=>{   if(confirm("এই batch-এর সব scan মুছবে?")){     items=[];     save();   } };  document.getElementById("export").onclick=()=>{   const rows=[["Batch","Barcode","Weight KG","Time"],     ...items.map(x=>[x.batch,x.code,x.kg,x.time])];   const csv=rows.map(row=>row.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(",")).join("\n");   const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"});   const url=URL.createObjectURL(blob);   const a=document.createElement("a");   a.href=url;   a.download="garments-scan.csv";   a.click();   URL.revokeObjectURL(url); };  render(); </script> </body> </html>
